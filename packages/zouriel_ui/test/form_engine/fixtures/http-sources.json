  "fillPattern": [
    {
      "obj": {
        "a": {
          "b": "deep"
        }
      },
      "pattern": "a.b",
      "expected": "deep"
    },
    {
      "obj": {
        "a": {
          "b": "deep"
        }
      },
      "pattern": " a.b ",
      "expected": "deep"
    },
    {
      "obj": {
        "first": "Ana",
        "last": null,
        "tags": [
          "x",
          "y"
        ],
        "n": 2.5
      },
      "pattern": "{ first }  {last} {tags} #{n}",
      "expected": "Ana [\"x\",\"y\"] #2.5"
    },
    {
      "obj": {
        "a": 1
      },
      "pattern": "",
      "expected": ""
    },
    {
      "obj": {
        "a": {
          "b": 1
        }
      },
      "pattern": "a",
      "expected": "{\"b\":1}"
    },
    {
      "obj": [
        "zero",
        "one"
      ],
      "pattern": "1",
      "expected": "one"
    }
  ],
