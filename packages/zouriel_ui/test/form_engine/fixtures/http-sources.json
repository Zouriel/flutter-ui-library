  "readSourceReply": [
    {
      "name": "items, combined labels and totals",
      "config": {
        "type": "users",
        "label": "Users",
        "url": "https://dummy.test/users/search",
        "paging": "offset",
        "pageParam": "skip",
        "pageSizeParam": "limit",
        "pageSize": 2,
        "itemsPath": "users",
        "valueField": "id",
        "labelField": "{firstName} {lastName}",
        "descriptionField": "email",
        "totalPath": "total"
      },
      "reply": {
        "users": [
          {
            "id": 1,
            "firstName": "Aminath",
            "lastName": "Shareef",
            "email": "a@x.mv"
          },
          {
            "id": 2,
            "firstName": "Ali",
            "lastName": "Zahir",
            "email": "z@x.mv"
          }
        ],
        "total": 30
      },
      "pageSize": 2,
      "expected": {
        "items": [
          {
            "value": 1,
            "label": "Aminath Shareef",
            "description": "a@x.mv"
          },
          {
            "value": 2,
            "label": "Ali Zahir",
            "description": "z@x.mv"
          }
        ],
        "total": 30,
        "hasMore": null
      }
    },
    {
      "name": "a short page is the last",
      "config": {
        "type": "c",
        "label": "C",
        "url": "https://api.test/courses",
        "firstPage": 0,
        "valueField": "id",
        "labelField": "meta.name",
        "descriptionField": "{code} ({meta.kind})"
      },
      "reply": [
        {
          "id": "a1",
          "meta": {
            "name": "Anatomy",
            "kind": "core"
          },
          "code": "AN1"
        },
        {
          "id": "",
          "meta": {}
        },
        {
          "id": true,
          "meta": {
            "name": null
          }
        }
      ],
      "pageSize": 20,
      "expected": {
        "items": [
          {
            "value": "a1",
            "label": "Anatomy",
            "description": "AN1 (core)"
          },
          {
            "value": "true",
            "label": "true",
            "description": "()"
          }
        ],
        "total": null,
        "hasMore": false
      }
    },
    {
      "name": "hasMore and total read from the reply",
      "config": {
        "type": "c",
        "label": "C",
        "url": "https://api.test/courses",
        "firstPage": 0,
        "valueField": "id",
        "labelField": "name",
        "itemsPath": "data.items",
        "totalPath": "data.count",
        "hasMorePath": "data.more"
      },
      "reply": {
        "data": {
          "items": [
            {
              "id": 5,
              "name": "Five"
            }
          ],
          "count": "12",
          "more": 1
        }
      },
      "pageSize": 1,
      "expected": {
        "items": [
          {
            "value": 5,
            "label": "Five"
          }
        ],
        "total": 12,
        "hasMore": true
      }
    },
    {
      "name": "a total that is not a number is left out",
      "config": {
        "type": "c",
        "label": "C",
        "url": "https://api.test/courses",
        "firstPage": 0,
        "valueField": "id",
        "labelField": "name",
        "totalPath": "nope",
        "hasMorePath": "more"
      },
      "reply": [
        {
          "id": 1,
          "name": "One"
        }
      ],
      "pageSize": 1,
      "expected": {
        "items": [
          {
            "value": 1,
            "label": "One"
          }
        ],
        "total": null,
        "hasMore": null
      }
    },
    {
      "name": "no list where the setup says",
      "config": {
        "type": "users",
        "label": "Users",
        "url": "https://dummy.test/users/search",
        "paging": "offset",
        "pageParam": "skip",
        "pageSizeParam": "limit",
        "pageSize": 2,
        "itemsPath": "data",
        "valueField": "id",
        "labelField": "{firstName} {lastName}",
        "descriptionField": "email",
        "totalPath": "total"
      },
      "reply": {
        "users": [
          {
            "id": 1,
            "firstName": "Aminath",
            "lastName": "Shareef",
            "email": "a@x.mv"
          },
          {
            "id": 2,
            "firstName": "Ali",
            "lastName": "Zahir",
            "email": "z@x.mv"
          }
        ],
        "total": 30
      },
      "pageSize": 2,
      "error": "No list at “data” in the reply (it has: users, total)."
    },
    {
      "name": "the reply is not a list",
      "config": {
        "type": "c",
        "label": "C",
        "url": "https://api.test/courses",
        "firstPage": 0,
        "valueField": "id",
        "labelField": "name"
      },
      "reply": {
        "results": [],
