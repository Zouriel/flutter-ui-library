{
  "kind": "localize",
  "text": [
    {
      "name": "exact locale",
      "text": {
        "en": "Name",
        "dv": "ނަން"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "ނަން"
    },
    {
      "name": "same language, other region",
      "text": {
        "dv": "ނަން",
        "en": "Name"
      },
      "locale": "dv-MV",
      "defaultLocale": "en",
      "expected": "ނަން"
    },
    {
      "name": "map key has a region, request does not",
      "text": {
        "en-GB": "Colour",
        "dv": "ކުލަ"
      },
      "locale": "en",
      "defaultLocale": "dv",
      "expected": "Colour"
    },
    {
      "name": "falls back to the default locale",
      "text": {
        "en": "Name"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "Name"
    },
    {
      "name": "falls back to the first non-empty entry",
      "text": {
        "fr": "Nom"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "Nom"
    },
    {
      "name": "a plain string is the same everywhere",
      "text": "Name",
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "Name"
    },
    {
      "name": "blank counts as missing",
      "text": {
        "en": "Name",
        "dv": "  "
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "Name"
    },
    {
      "name": "blank default falls to the first non-empty",
      "text": {
        "en": "",
        "dv": "ނަން"
      },
      "locale": "fr",
      "defaultLocale": "en",
      "expected": "ނަން"
    },
    {
      "name": "no locale asked for uses the default",
      "text": {
        "en": "A",
        "dv": "B"
      },
      "locale": null,
      "defaultLocale": "dv",
      "expected": "B"
    },
    {
      "name": "no locale and no default means en",
      "text": {
        "en": "A",
        "dv": "B"
      },
      "locale": null,
      "defaultLocale": null,
      "expected": "A"
    },
    {
      "name": "all blank",
      "text": {
        "en": "",
        "dv": " "
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "name": "empty map",
      "text": {},
      "locale": "en",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "name": "empty string",
      "text": "",
      "locale": "en",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "name": "missing text",
      "text": null,
      "locale": "en",
      "defaultLocale": "en",
      "expected": ""
    }
  ],
  "textIn": [
    {
      "text": {
        "en": "A",
        "dv": "B"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": "B"
    },
    {
      "text": {
        "en": "A"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "text": "A",
      "locale": "en",
      "defaultLocale": "en",
      "expected": "A"
    },
    {
      "text": "A",
      "locale": "dv",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "text": "A",
      "locale": "dv",
      "defaultLocale": "dv",
      "expected": "A"
    },
    {
      "text": "A",
      "locale": "en",
      "defaultLocale": null,
      "expected": "A"
    },
    {
      "text": {
        "en": "A",
        "dv-MV": "B"
      },
      "locale": "dv",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "text": null,
      "locale": "en",
      "defaultLocale": "en",
      "expected": ""
    }
  ],
  "setText": [
    {
      "name": "a plain string becomes a map on the first translation",
      "text": "Name",
      "locale": "dv",
      "value": "ނަން",
      "defaultLocale": "en",
      "expected": {
        "en": "Name",
        "dv": "ނަން"
      }
    },
    {
      "name": "blank translation collapses back to a string",
      "text": {
        "en": "Name",
        "dv": "x"
      },
      "locale": "dv",
      "value": "",
      "defaultLocale": "en",
      "expected": "Name"
    },
    {
      "name": "whitespace counts as blank",
      "text": {
        "en": "Name",
        "dv": "x"
      },
      "locale": "dv",
      "value": "  ",
      "defaultLocale": "en",
      "expected": "Name"
    },
    {
      "name": "editing the default of a plain string",
      "text": "Name",
      "locale": "en",
      "value": "Other",
      "defaultLocale": "en",
      "expected": "Other"
    },
    {
      "name": "editing one translation of a map",
      "text": {
        "en": "A",
        "dv": "B"
      },
      "locale": "dv",
      "value": "C",
      "defaultLocale": "en",
      "expected": {
        "en": "A",
        "dv": "C"
      }
    },
    {
      "name": "first text written in a translation only",
      "text": "",
      "locale": "dv",
      "value": "ނަން",
      "defaultLocale": "en",
      "expected": {
        "dv": "ނަން"
      }
    },
    {
      "name": "first text from nothing",
      "text": null,
      "locale": "dv",
      "value": "x",
      "defaultLocale": "en",
      "expected": {
        "dv": "x"
      }
    },
    {
      "name": "blank default stays while another language has text",
      "text": {
        "en": "A",
        "fr": "B"
      },
      "locale": "en",
      "value": "",
      "defaultLocale": "en",
      "expected": {
        "en": "",
        "fr": "B"
      }
    },
    {
      "name": "clearing the only text",
      "text": "A",
      "locale": "en",
      "value": "",
      "defaultLocale": "en",
      "expected": ""
    },
    {
      "name": "removing a blank translation among several",
      "text": {
        "en": "A",
        "dv": "B",
        "fr": "C"
      },
      "locale": "fr",
      "value": "",
      "defaultLocale": "en",
      "expected": {
        "en": "A",
        "dv": "B"
      }
    }
  ],
