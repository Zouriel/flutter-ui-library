  "lintTranslations": [
    {
      "name": "one warning per element and language",
      "definition": {
        "schemaVersion": 2,
        "id": "f",
        "title": {
          "en": "Form",
          "dv": "ފޯމް"
        },
        "defaultLocale": "en",
        "supportedLocales": [
          {
            "code": "en"
          },
          {
            "code": "dv",
            "label": "Dhivehi"
          }
        ],
        "pages": [
          {
            "id": "p1",
            "title": {
              "en": "Page one"
            },
            "elements": [
              {
                "kind": "field",
                "id": "a",
                "type": "text",
                "key": "name",
                "label": {
                  "en": "Full name",
                  "dv": "ފުރިހަމަ ނަން"
                },
                "help": {
                  "en": "As on your ID"
                },
                "placeholder": "e.g. Aisha"
              },
              {
                "kind": "field",
                "id": "b",
                "type": "select",
                "key": "colour",
                "label": "Colour",
                "options": [
                  {
                    "id": "o1",
                    "value": "r",
                    "label": {
                      "en": "Red",
                      "dv": "ރަތް"
                    }
                  },
                  {
                    "id": "o2",
                    "value": "g",
                    "label": "Green"
                  }
                ]
              },
              {
                "kind": "field",
                "id": "c",
                "type": "text",
                "key": "old",
                "label": "Old question",
                "archived": true
              },
              {
                "kind": "static",
                "id": "s",
                "type": "paragraph",
                "text": "Hello"
              },
              {
                "kind": "group",
                "id": "g",
                "key": "kids",
                "title": {
                  "en": "Kids",
                  "dv": "ކުދިން"
                },
                "repeat": {
                  "addLabel": "Add child"
                },
                "elements": []
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "warning",
          "targetId": "p1",
          "message": "“Page one” has no Dhivehi (dv) translation for: title."
        },
        {
          "severity": "warning",
          "targetId": "a",
          "message": "“Full name” has no Dhivehi (dv) translation for: help text, placeholder."
        },
        {
          "severity": "warning",
          "targetId": "b",
          "message": "“Colour” has no Dhivehi (dv) translation for: label, option 2."
        },
        {
          "severity": "warning",
          "targetId": "s",
          "message": "“Hello” has no Dhivehi (dv) translation for: text."
        },
        {
          "severity": "warning",
          "targetId": "g",
          "message": "“Kids” has no Dhivehi (dv) translation for: add button label."
        }
      ]
    },
